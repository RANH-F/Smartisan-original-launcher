            <solid android:color="@color/tt_listview_press" />
            <corners android:radius="2.0dp" android:topLeftRadius="0.0dp" android:topRightRadius="0.0dp" android:bottomLeftRadius="5.0dp" android:bottomRightRadius="5.0dp" />
