<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/contacts_info_layout" android:layout_width="match_parent" android:layout_height="@dimen/contacts_card_horizontal_height"
  xmlns:android="http://schemas.android.com/apk/res/android">
