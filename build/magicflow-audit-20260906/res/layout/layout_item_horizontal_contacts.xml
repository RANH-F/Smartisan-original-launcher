        <com.smartisanos.magicflow.view.card.contacts.AvatarImageView android:id="@id/acatar_img" android:layout_width="@dimen/contacts_item_horizontal_image_height" android:layout_height="@dimen/contacts_item_horizontal_image_height" android:scaleType="fitXY" />
