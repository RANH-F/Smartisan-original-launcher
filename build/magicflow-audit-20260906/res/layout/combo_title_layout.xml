<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <include layout="@layout/primary_title_layout" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <FrameLayout android:id="@id/secondary_bar_container" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <ImageView android:id="@id/primary_title_shadow" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </FrameLayout>
    <include android:id="@id/secondary_bar_shadow" android:visibility="gone" layout="@layout/title_secondary_bar_shadow" />
</LinearLayout>
