<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:background="#ffffff" android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:smartisan="http://schemas.android.com/apk/res-auto">
    <smartisan.widget.TitleBar android:id="@id/view_title" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent" android:layout_below="@id/view_title">
        <include android:id="@id/webview_no_net" layout="@layout/no_network_layout" />
        <WebView android:id="@id/web_view" android:layout_width="match_parent" android:layout_height="match_parent" android:overScrollMode="never" />
    </FrameLayout>
</RelativeLayout>
