<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout android:id="@id/item_background" android:visibility="invisible" android:layout_width="wrap_content" android:layout_height="match_parent">
        <FrameLayout android:id="@id/delete_item" android:layout_width="wrap_content" android:layout_height="match_parent">
            <ImageView android:background="@drawable/slide_delete_back_shadow" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:background="@drawable/slide_delete_back" android:layout_width="match_parent" android:layout_height="match_parent" />
            <ImageView android:layout_gravity="center" android:background="@drawable/slide_delete" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/news_slide_delete_margin" android:layout_marginRight="@dimen/news_slide_delete_margin" />
        </FrameLayout>
    </FrameLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/item_foreground" android:layout_width="match_parent" android:layout_height="@dimen/news_item_height">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/message_background" android:layout_width="match_parent" android:layout_height="match_parent">
            <ImageView android:id="@id/check_box_img" android:visibility="visible" android:layout_width="@dimen/newsitem_image_width_single" android:layout_height="@dimen/newsitem_image_height_single" android:src="@drawable/browser_list_edit" />
            <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/newsitem_image_margin_left_single" android:layout_marginRight="@dimen/readlater_button_margin_left" android:layout_weight="1.0">
                <include layout="@layout/layout_block_title_text" />
                <LinearLayout android:gravity="end|center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/newsitem_source_margin_top_no_image">
                    <include layout="@layout/layout_block_source_text" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
