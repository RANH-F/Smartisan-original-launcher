<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:orientation="vertical" android:id="@id/card_hotel_item" android:paddingBottom="@dimen/card_padding" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="horizontal" android:id="@id/card_hotel_item_content" android:background="@drawable/hotel" android:layout_width="match_parent" android:layout_height="@dimen/life_info_card_height">
        <LinearLayout android:orientation="vertical" android:layout_width="0.0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:layout_marginStart="@dimen/card_content_padding" android:layout_marginEnd="@dimen/life_info_card_base_info_margin_right">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/card_content_padding">
                <ImageView android:id="@id/hotel_company_icon" android:background="@drawable/icon_hotel_default" android:layout_width="48.0px" android:layout_height="48.0px" android:layout_marginEnd="6.0dp" />
