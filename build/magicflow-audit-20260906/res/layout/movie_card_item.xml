<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/card_movie_item" android:paddingBottom="@dimen/card_padding" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
