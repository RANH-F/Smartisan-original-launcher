                <TextView android:textSize="36.0px" android:textColor="#80000000" android:ellipsize="end" android:id="@id/card_movie_ticket_verify_num" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:layout_marginStart="2.0dp" />
